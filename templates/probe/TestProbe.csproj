<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only addon. KSP_DIR is /ksp in the ksp-moddev image. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputPath>out/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <KspDir Condition="'$(KspDir)' == ''">$(KSP_DIR)</KspDir>
    <KspDir Condition="'$(KspDir)' == ''">/ksp</KspDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(KspDir)/KSP_Data/Managed/Assembly-CSharp.dll"><Private>false</Private></Reference>
    <Reference Include="$(KspDir)/KSP_Data/Managed/UnityEngine*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
