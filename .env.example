# Copy to .env and adjust.

# Your KSP 1.12 install (read-only in the container; only KSP_Data/Managed is used).
#   Linux (Steam):   ~/.local/share/Steam/steamapps/common/Kerbal Space Program
#   Windows (Steam): C:/Program Files (x86)/Steam/steamapps/common/Kerbal Space Program
#   macOS (Steam):   ~/Library/Application Support/Steam/steamapps/common/Kerbal Space Program
KSP_GAME=

# Folder with your mod repos, mounted at /work (default: ./work next to compose.yml).
#KSP_WORK=./work

# Owner of the files in KSP_WORK (run `id -u` / `id -g`). Docker Desktop users can keep 1000.
#PUID=1000
#PGID=1000

# Optional password for the noVNC desktop. Set one if you publish the port beyond 127.0.0.1.
#VNC_PASSWORD=

#MODDEV_PORT=6080
#MODDEV_GEOMETRY=1920x1080x24
