#!/bin/bash
# Opens the Unity editor on the virtual desktop. Usage: unity-gui [project-path]
# Activate the Personal license first (see docs/license.md).
set -euo pipefail
export DISPLAY="${DISPLAY:-:1}"
args=(-force-glcore -logFile "$HOME/unity-editor.log")
[ -n "${1:-}" ] && args+=(-projectPath "$(realpath "$1")")
exec "$UNITY_EDITOR" "${args[@]}"
