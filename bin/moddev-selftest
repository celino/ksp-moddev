#!/bin/bash
# Confere se a imagem tem tudo. Não precisa de licença nem de GUI aberta.
set -uo pipefail
fail=0
check() { local name="$1"; shift; if out="$("$@" 2>&1)"; then printf '  ok    %-22s %s\n' "$name" "$(echo "$out" | head -1)"; else printf '  FALHA %-22s %s\n' "$name" "$(echo "$out" | tail -1)"; fail=1; fi; }
echo "ksp-moddev selftest"
check "unity editor"      bash -c '"$UNITY_EDITOR" -version 2>/dev/null | grep -m1 "2019.4.18f1"'
check "módulo windows"    bash -c 'ls -d /opt/unity/Editor/Data/PlaybackEngines/WindowsStandaloneSupport >/dev/null && echo WindowsStandaloneSupport'
check "unity hub"         bash -c 'dpkg-query -W -f "\${Version}" unityhub'
check "dotnet sdk"        dotnet --version
check "xvfb/openbox/vnc"  bash -c 'command -v Xvfb openbox x11vnc websockify >/dev/null && echo presentes'
check "novnc"             bash -c 'test -f /usr/share/novnc/vnc.html && echo /usr/share/novnc'
check "gl (llvmpipe)"     bash -c 'xvfb-run -a glxinfo -B | grep -m1 "OpenGL renderer"'
check "parttools"         fetch-parttools
check "uid do usuário"    bash -c 'echo "$(id -un) $(id -u):$(id -g)"'
if [ -d "${KSP_DIR:-/ksp}/KSP_Data/Managed" ]; then
  check "dlls do KSP (/ksp)" bash -c 'ls "$KSP_DIR/KSP_Data/Managed/Assembly-CSharp.dll"'
else
  echo "  --    dlls do KSP (/ksp)     não montado (opcional)"
fi
[ $fail = 0 ] && echo "tudo certo" || { echo "há falhas"; exit 1; }
